---
import Layout from "../layouts/Layout.astro";
import Cabecera from "../components/Cabecera.astro";
import EtapaCard from "../components/EtapaCard.astro";
import EtapasIntro from "../components/EtapasIntro.astro";
import JsonLd from "../components/JsonLd.astro";
import Sp2Shell from "../components/Sp2Shell.astro";
import Pie from "../components/Pie.astro";
import { getImageDimensions } from "../data/image-dimensions";
import { etapas } from "../data/etapas";
import { createSocialImageMetadata } from "../data/site";
import { getSiteBase } from "../data/seo-urls";
import { buildEtapaItemListSchema, buildWebSiteSchema } from "../data/structured-data";

const homeHeroDimensions = getImageDimensions("/images/fondo_playa.webp");
const homeDescription =
  "Ruta de cinco etapas por la costa de Cabo de Gata-Níjar con contexto histórico sobre corsarios, audio introductorio y acceso a los recursos de cada etapa.";
const homeSocialImage = createSocialImageMetadata(
  "/images/fondo_playa.webp",
  "Paisaje costero de Cabo de Gata",
);
const site = getSiteBase(Astro.site, Astro.url);
const homeSchemas = [buildWebSiteSchema({ site }), buildEtapaItemListSchema({ site })];
---

<Layout
  title="Senda Pirata"
  description={homeDescription}
  socialImage={homeSocialImage}
>
  <JsonLd slot="head" data={homeSchemas} />
  <Sp2Shell>
    <Cabecera
      class="text-center mb-10"
      containerClass="flex items-center justify-center"
      showBreadcrumb={false}
      logoSrc="/images/logo.webp"
      logoAlt="Senda Pirata Logo"
      logoClass="block object-contain max-w-full max-h-[100px]"
    />

    <div class="w-full mb-[30px] overflow-hidden rounded-[25px]">
      <img
        class="w-full h-auto block"
        src="/images/fondo_playa.webp"
        alt="Paisaje costero de Cabo de Gata"
        width={homeHeroDimensions.width}
        height={homeHeroDimensions.height}
        loading="eager"
        fetchpriority="high"
      />
    </div>

		<h1 class="text-center font-bold text-black text-[32px] md:text-[42px] font-['thornwood-vf',_sans-serif]">
		  Comienza la Senda Pirata
		</h1>

		<EtapasIntro />

		<div class="mb-10" aria-label="Etapas">
		  {etapas.map((etapa) => (
			<EtapaCard etapa={etapa} variant="home" />
		  ))}
		</div>

    <Pie class="mt-10 pt-[30px] border-t-2 border-[#ddd]" containerClass="p-0" />
  </Sp2Shell>
</Layout>
