---
import Layout from '../layouts/Layout.astro';
import Mapa from '../components/Mapa.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
---

<Layout
	title="Senda Pirata"
	description="Cinco etapas por la costa de Cabo de Gata-Níjar, entre torres vigía, fortalezas y calas con historia corsaria."
>
	<div class="min-h-screen">
		<div class="relative" id="map-container">
			<div class="fixed inset-0">
				<Mapa
					minHeight="100vh"
					interactive={false}
					showExpand={false}
					enableRouteHighlight={true}
					// Empuja el encuadre hacia la zona superior derecha
					fitPadding={{ top: 90, right: 90, bottom: 520, left: 660 }}
					fitMaxHeight={300}
				/>
			</div>

			<div class="relative z-10">
				<div class="mx-auto max-w-6xl px-6 pt-12 sm:pt-16">
					<div class="max-w-lg">
						<div class="flex items-center gap-4">
							<img
								src="/images/senda-logo.png"
								alt="Senda Pirata"
								class="h-22 object-contain"
								loading="eager"
								decoding="async"
							/>
						</div>

						<h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">
							Camina la costa como quien vigilaba el horizonte.
						</h1>
						<p class="mt-4 text-lg text-[var(--sp-muted)]">
							Torres, fortalezas y calas conservan las historias de una frontera mediterránea siempre alerta. Explora las etapas, descarga los tracks y
							escucha el audio para entrar en contexto antes de empezar.
						</p>
					</div>
				</div>
			</div>

			<section class="mt-12 relative z-10 mx-auto max-w-6xl px-6">
				<p class="text-xs font-semibold uppercase tracking-wider text-[var(--sp-muted-2)]">Etapas</p>
				<h2 class="mt-2 text-2xl font-bold">Cinco etapas, una historia</h2>

				<div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					<div class="sm:col-span-2 lg:col-span-1">
						<AudioPlayer
							minimal={true}
							src="/descargas/intro.mp3"
							title="Audio introductorio"
							subtitle="Activa el contexto antes de zarpar"
						/>
					</div>

					<a
						href="/etapas/etapa-01"
						data-route-id="ruta-01"
						class="group rounded-3xl border-2 border-route-01 bg-white p-5 hover:shadow-lg hover:scale-102 transition-all duration-300"
					>
						<p class="flex items-center gap-2 text-xs font-semibold !text-route-01">
							<span class="h-2.5 w-2.5 rounded-full bg-route-01"></span>
							<span>Etapa 01</span>
						</p>
						<p class="mt-2 text-lg font-bold text-route-01">El Guardián del Horizonte</p>
						<p class="mt-1 text-sm text-[var(--sp-muted)]">Agua Amarga → Las Negras · 13 km</p>
					</a>
					<a
						href="/etapas/etapa-02"
						data-route-id="ruta-02"
						class="group rounded-3xl border-2 border-route-02 bg-white p-5 hover:shadow-lg hover:scale-102 transition-all duration-300"
					>
						<p class="flex items-center gap-2 text-xs font-semibold !text-route-02">
							<span class="h-2.5 w-2.5 rounded-full bg-route-02"></span>
							<span>Etapa 02</span>
						</p>
						<p class="mt-2 text-lg font-bold text-route-02">La Custodia del Alumbre</p>
						<p class="mt-1 text-sm text-[var(--sp-muted)]">Las Negras → Rodalquilar · 17 km</p>
					</a>
					<a
						href="/etapas/etapa-03"
						data-route-id="ruta-03"
						class="group rounded-3xl border-2 border-route-03 bg-white p-5 hover:shadow-lg hover:scale-102 transition-all duration-300"
					>
						<p class="flex items-center gap-2 text-xs font-semibold !text-route-03">
							<span class="h-2.5 w-2.5 rounded-full bg-route-03"></span>
							<span>Etapa 03</span>
						</p>
						<p class="mt-2 text-lg font-bold text-route-03">Camino del Botín</p>
						<p class="mt-1 text-sm text-[var(--sp-muted)]">Rodalquilar → La Isleta · 14,2 km</p>
					</a>
					<a
						href="/etapas/etapa-04"
						data-route-id="ruta-04"
						class="group rounded-3xl border-2 border-route-04 bg-white p-5 hover:shadow-lg hover:scale-102 transition-all duration-300"
					>
						<p class="flex items-center gap-2 text-xs font-semibold !text-route-04">
							<span class="h-2.5 w-2.5 rounded-full bg-route-04"></span>
							<span>Etapa 04</span>
						</p>
						<p class="mt-2 text-lg font-bold text-route-04">El Anillo Defensivo</p>
						<p class="mt-1 text-sm text-[var(--sp-muted)]">La Isleta → San José · 12,3 km</p>
					</a>
					<a
						href="/etapas/etapa-05"
						data-route-id="ruta-05"
						class="group rounded-3xl border-2 border-route-05 bg-white p-5 hover:shadow-lg hover:scale-102 transition-all duration-300"
					>
						<p class="flex items-center gap-2 text-xs font-semibold !text-route-05">
							<span class="h-2.5 w-2.5 rounded-full bg-route-05"></span>
							<span>Etapa 05</span>
						</p>
						<p class="mt-2 text-lg font-bold text-route-05">El Fin de la Frontera</p>
						<p class="mt-1 text-sm text-[var(--sp-muted)]">San José → La Fabriquilla · 15,12 km</p>
					</a>
				</div>
			</section>

		</div>

		<footer class="mt-14 border-t border-[var(--sp-border)] pt-8 text-sm text-[var(--sp-muted)] relative z-10 mx-auto max-w-6xl px-6">
			<p>
				<span class="font-semibold text-[var(--sp-text)]">Senda Pirata</span> · Ruta por etapas · Cabo de Gata-Níjar
			</p>
		</footer>

	</div>
</Layout>

<script is:inline>
	;(() => {
		const cards = Array.from(document.querySelectorAll('[data-route-id]'))
		if (!cards.length) return

		const emit = (routeId) => {
			window.dispatchEvent(new CustomEvent('sp:route-highlight', { detail: { routeId } }))
		}

		for (const el of cards) {
			el.addEventListener('pointerenter', () => emit(el.getAttribute('data-route-id')))
			el.addEventListener('pointerleave', () => emit(null))
			el.addEventListener('focus', () => emit(el.getAttribute('data-route-id')))
			el.addEventListener('blur', () => emit(null))
		}
	})()
</script>
