---
import Layout from "../layouts/Layout.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import Cabecera from "../components/Cabecera.astro";
import index2CssUrl from "../styles/index2.css?url";
---

<Layout
  title="Senda Pirata"
  description="Ruta de cinco etapas por la costa de Cabo de Gata-Níjar."
>
  <div class="sp2">
    <link rel="stylesheet" href={index2CssUrl} />
    <link rel="stylesheet" href="https://use.typekit.net/pbz8sah.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />

    <div class="container">
      <div class="card">
        <Cabecera
          class="header"
          containerClass="logo-container"
          showBreadcrumb={false}
          logoSrc="/sendapirata_html/logo.webp"
          logoAlt="Senda Pirata Logo"
          logoClass="logo-img"
        />

        <div class="main-image">
          <img src="/sendapirata_html/fondo_playa.webp" alt="Paisaje costero de Cabo de Gata" />
        </div>

        <h2 class="main-title">Comienza la Senda Pirata</h2>

        <div class="intro-section">
          <div class="intro-icon">
            <a href="/descargas/intro.mp3" download aria-label="Descargar audio introductorio">
              <img src="/sendapirata_html/mp3.webp" alt="Reproducir audio MP3" />
            </a>
          </div>
          <div class="intro-text">
            <p>
              Esta ruta de cinco etapas recorre una costa marcada históricamente por los ataques de corsarios y los sistemas defensivos. Torres, fortalezas y calas conservan las historias de una frontera mediterránea siempre alerta. Te recomendamos escuchar el audio introductorio para comprender el contexto histórico antes de iniciar el recorrido.
            </p>
            <div style="margin-top: 16px;">
              <AudioPlayer
                minimal={true}
                src="/descargas/intro.mp3"
                title="Audio introductorio"
                subtitle="Activa el contexto antes de zarpar"
              />
            </div>
          </div>
        </div>

        <div class="stages-container" aria-label="Etapas">
          <div class="stage-item">
            <a href="/etapas/etapa-01" aria-label="Ir a Etapa 01">
              <img src="/sendapirata_html/01.webp" alt="Etapa 01" class="stage-seal" />
            </a>
            <div class="stage-header">
              <div class="stage-content">
                <h3 class="stage-title">
                  <a class="sp2-stageLink" href="/etapas/etapa-01">El Guardián del Horizonte</a>
                </h3>
                <p class="stage-route">Agua Amarga &gt; Las Negras · 13 km</p>
              </div>
              <div class="stage-downloads">
                <a href="/descargas/01.mp3">
                  <img src="/sendapirata_html/mp3.webp" alt="Reproducir MP3" class="download-icon" />
                </a>
                <a href="/descargas/01.pdf" download>
                  <img src="/sendapirata_html/pdf.webp" alt="PDF" class="download-icon" />
                </a>
                <a href="/descargas/01.gpx" download>
                  <img src="/sendapirata_html/gpx.webp" alt="GPX" class="download-icon" />
                </a>
              </div>
            </div>
          </div>

          <div class="stage-item">
            <a href="/etapas/etapa-02" aria-label="Ir a Etapa 02">
              <img src="/sendapirata_html/02.webp" alt="Etapa 02" class="stage-seal" />
            </a>
            <div class="stage-header">
              <div class="stage-content">
                <h3 class="stage-title">
                  <a class="sp2-stageLink" href="/etapas/etapa-02">La Custodia del Alumbre y la Protección de los Mineros</a>
                </h3>
                <p class="stage-route">Las Negras &gt; Rodalquilar · 17 km</p>
              </div>
              <div class="stage-downloads">
                <a href="/descargas/02.pdf" download>
                  <img src="/sendapirata_html/pdf.webp" alt="PDF" class="download-icon" />
                </a>
                <a href="/descargas/02.gpx" download>
                  <img src="/sendapirata_html/gpx.webp" alt="GPX" class="download-icon" />
                </a>
              </div>
            </div>
          </div>

          <div class="stage-item">
            <a href="/etapas/etapa-03" aria-label="Ir a Etapa 03">
              <img src="/sendapirata_html/03.webp" alt="Etapa 03" class="stage-seal" />
            </a>
            <div class="stage-header">
              <div class="stage-content">
                <h3 class="stage-title">
                  <a class="sp2-stageLink" href="/etapas/etapa-03">Camino del Botín y la Indefensión del Interior</a>
                </h3>
                <p class="stage-route">Rodalquilar &gt; La Isleta del Moro · 14,2 km</p>
              </div>
              <div class="stage-downloads">
                <a href="/descargas/03.pdf" download>
                  <img src="/sendapirata_html/pdf.webp" alt="PDF" class="download-icon" />
                </a>
                <a href="/descargas/03.gpx" download>
                  <img src="/sendapirata_html/gpx.webp" alt="GPX" class="download-icon" />
                </a>
              </div>
            </div>
          </div>

          <div class="stage-item">
            <a href="/etapas/etapa-04" aria-label="Ir a Etapa 04">
              <img src="/sendapirata_html/04.webp" alt="Etapa 04" class="stage-seal" />
            </a>
            <div class="stage-header">
              <div class="stage-content">
                <h3 class="stage-title">
                  <a class="sp2-stageLink" href="/etapas/etapa-04">El Anillo Defensivo</a>
                </h3>
                <p class="stage-route">La Isleta del Moro &gt; San José · 12,3 km</p>
              </div>
              <div class="stage-downloads">
                <a href="/descargas/04.pdf" download>
                  <img src="/sendapirata_html/pdf.webp" alt="PDF" class="download-icon" />
                </a>
                <a href="/descargas/04.gpx" download>
                  <img src="/sendapirata_html/gpx.webp" alt="GPX" class="download-icon" />
                </a>
              </div>
            </div>
          </div>

          <div class="stage-item">
            <a href="/etapas/etapa-05" aria-label="Ir a Etapa 05">
              <img src="/sendapirata_html/05.webp" alt="Etapa 05" class="stage-seal" />
            </a>
            <div class="stage-header">
              <div class="stage-content">
                <h3 class="stage-title">
                  <a class="sp2-stageLink" href="/etapas/etapa-05">El Fin de la Frontera</a>
                </h3>
                <p class="stage-route">San José &gt; La Fabriquilla (Faro) · 15,12 km</p>
              </div>
              <div class="stage-downloads">
                <a href="/descargas/05.pdf" download>
                  <img src="/sendapirata_html/pdf.webp" alt="PDF" class="download-icon" />
                </a>
                <a href="/descargas/05.gpx" download>
                  <img src="/sendapirata_html/gpx.webp" alt="GPX" class="download-icon" />
                </a>
              </div>
            </div>
          </div>
        </div>

        <footer class="footer">
          <div class="footer-logo">
            <img src="/sendapirata_html/asemparna.webp" alt="ASEMPARNA" />
          </div>
          <div class="footer-logo">
            <img src="/sendapirata_html/ayuntamiento.webp" alt="Ayuntamiento de Níjar" />
          </div>
        </footer>
      </div>
    </div>

  </div>

  <style>
    .sp2 {
      width: 100%;
    }

    /* Links de etapa sin estilos de enlace */
    .sp2-stageLink {
      color: inherit;
      text-decoration: none;
    }

    .sp2-stageLink:hover {
      text-decoration: underline;
    }
  </style>
</Layout>

