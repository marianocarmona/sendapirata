---
import Layout from '../../layouts/Layout.astro';
import EtapaNav from '../../components/EtapaNav.astro';
import Sp2Shell from '../../components/Sp2Shell.astro';
import Pie from '../../components/Pie.astro';
import Cabecera from '../../components/Cabecera.astro';
import EtapaCierre from '../../components/EtapaCierre.astro';
import EtapaHero from '../../components/EtapaHero.astro';
import EtapaOverview from '../../components/EtapaOverview.astro';
import EtapaTreasureCard from '../../components/EtapaTreasureCard.astro';
import EtapaWarning from '../../components/EtapaWarning.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getEtapa } from '../../data/etapas';
import { getSiteBase } from '../../data/seo-urls';
import {
	buildBreadcrumbListSchema,
	buildEtapaSchemas,
	type SchemaNode,
} from '../../data/structured-data';

const etapa = getEtapa(4);
const pagePath = Astro.url.pathname;
const site = getSiteBase(Astro.site, Astro.url);
const breadcrumbSchema = buildBreadcrumbListSchema(
	[
		{ name: 'Inicio', path: '/' },
		{ name: 'Etapas', path: '/etapas' },
		{ name: `Etapa ${etapa.idLabel}`, path: pagePath },
	],
	{ site },
);
const etapaSchemas = [...buildEtapaSchemas(etapa, { site }), breadcrumbSchema].filter(
	(schema): schema is SchemaNode => Boolean(schema),
);
---

<Layout title={etapa.layoutTitle} description={etapa.layoutDescription}>
	<JsonLd slot="head" data={etapaSchemas} />
	<Sp2Shell>
		<Cabecera etapa={etapa.id}
			class="text-center mb-10"
			containerClass=""
			showBreadcrumb={true}
			logoSrc="/images/logo.webp"
			logoAlt="Senda Pirata Logo"
			logoClass="block object-contain max-w-full max-h-[120px] mx-auto"
		/>

		<EtapaHero etapa={etapa} />
		<EtapaOverview etapa={etapa} />

		<section class="[&>p]:text-base [&>p]:leading-[1.75] [&>p]:text-[#333] [&>p+p]:mt-3">
			<h2 class="mt-[26px] mb-3 text-[26px] font-bold text-black font-['thornwood-vf',_sans-serif]">Relato</h2>
			<p>
				Dejas atrás la Isleta, el antiguo escondite pirata, para ascender a la línea de fuego. En este tramo, te conviertes en parte del sistema de vigilancia que
				protegía los fondeaderos más codiciados: la ensenada del Sollarete, hoy San José.
			</p>
			<p>
				Tu ruta te exige subir a los puntos de vista donde el centinela jugaba con la vida de todo el Reino. Si el fuego de alerta fallaba aquí, las consecuencias
				eran catastróficas.
			</p>
		</section>

		<section>
			<h2 class="mt-[26px] mb-3 text-[26px] font-bold text-black font-['thornwood-vf',_sans-serif]">Los tesoros escondidos</h2>
			<div class="mt-3 grid gap-[14px]">
				{etapa.treasures.map((treasure) => (
					<EtapaTreasureCard treasure={treasure} />
				))}
			</div>
		</section>

		<EtapaWarning paragraphs={etapa.warningParagraphs} />

		<EtapaCierre />

		<EtapaNav current={4} />
		<Pie />
	</Sp2Shell>
</Layout>
