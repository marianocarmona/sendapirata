---
import Layout from '../../layouts/Layout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
---

<Layout title="Etapas — Senda Pirata" description="Información y enlaces a todas las etapas de la Senda Pirata.">
	<main class="min-h-screen bg-transparent text-[var(--sp-text)]">
		<div class="mx-auto max-w-4xl px-6 py-10">
			<nav class="mb-8 text-sm text-[var(--sp-muted)]">
				<a class="underline decoration-[var(--sp-border)] underline-offset-4 hover:text-[var(--sp-text)]" href="/">Inicio</a>
				<span class="mx-2">/</span>
				<span class="text-[var(--sp-text)]">Etapas</span>
			</nav>

			<header class="mb-10">
				<p class="text-xs font-semibold uppercase tracking-wider text-[var(--sp-muted-2)]">Senda Pirata</p>
				<h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Etapas</h1>
			</header>

			<section class="mb-8">
				<p class="text-[var(--sp-muted)]">
					Esta ruta de cinco etapas recorre una costa marcada históricamente por los ataques de corsarios y los sistemas defensivos. Torres,
					fortalezas y calas conservan las historias de una frontera mediterránea siempre alerta. Te recomendamos escuchar el audio introductorio para
					comprender el contexto histórico antes de iniciar el recorrido.
				</p>
				<div class="mt-4">
					<div class="mt-2">
						<AudioPlayer
							minimal={true}
							src="/descargas/intro.mp3"
						/>
					</div>
				</div>
			</section>

			<section class="grid gap-4 sm:grid-cols-2">
				<article class="rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-5">
					<p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--sp-muted-2)]">
						<span class="h-2.5 w-2.5 rounded-full bg-route-01"></span>
						<span>Etapa 01</span>
					</p>
					<h2 class="mt-2 text-xl font-bold">El Guardián del Horizonte</h2>
					<p class="mt-1 text-[var(--sp-muted)]">Agua Amarga → Las Negras</p>
					<div class="mt-4 grid gap-2 text-sm text-[var(--sp-muted)]">
						<p><span class="font-semibold text-[var(--sp-text)]">Distancia:</span> 13 km</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Duración:</span> 3 horas y media</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Dificultad:</span> Medio-Alto</p>
					</div>
					<div class="mt-5 flex flex-wrap gap-2">
						<a class="inline-flex items-center rounded-md bg-[var(--sp-accent)] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90" href="/etapas/etapa-01">
							Ver etapa
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/01.pdf" download>
							PDF
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/01.gpx" download>
							GPX
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/01.mp3">
							Audio
						</a>
					</div>
				</article>

				<article class="rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-5">
					<p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--sp-muted-2)]">
						<span class="h-2.5 w-2.5 rounded-full bg-route-02"></span>
						<span>Etapa 02</span>
					</p>
					<h2 class="mt-2 text-xl font-bold">La Custodia del Alumbre y la Protección de los Mineros</h2>
					<p class="mt-1 text-[var(--sp-muted)]">Las Negras → Rodalquilar</p>
					<div class="mt-4 grid gap-2 text-sm text-[var(--sp-muted)]">
						<p><span class="font-semibold text-[var(--sp-text)]">Distancia:</span> 17 km</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Duración:</span> 4 horas y media</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Dificultad:</span> Media-Alta</p>
					</div>
					<div class="mt-5 flex flex-wrap gap-2">
						<a class="inline-flex items-center rounded-md bg-[var(--sp-accent)] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90" href="/etapas/etapa-02">
							Ver etapa
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/02.pdf" download>
							PDF
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/02.gpx" download>
							GPX
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/02.mp3">
							Audio
						</a>
					</div>
				</article>

				<article class="rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-5">
					<p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--sp-muted-2)]">
						<span class="h-2.5 w-2.5 rounded-full bg-route-03"></span>
						<span>Etapa 03</span>
					</p>
					<h2 class="mt-2 text-xl font-bold">Camino del Botín y la Indefensión del Interior</h2>
					<p class="mt-1 text-[var(--sp-muted)]">Rodalquilar → La Isleta del Moro</p>
					<div class="mt-4 grid gap-2 text-sm text-[var(--sp-muted)]">
						<p><span class="font-semibold text-[var(--sp-text)]">Distancia:</span> 14,2 km</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Duración:</span> 4 horas</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Dificultad:</span> Media-Alta</p>
					</div>
					<div class="mt-5 flex flex-wrap gap-2">
						<a class="inline-flex items-center rounded-md bg-[var(--sp-accent)] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90" href="/etapas/etapa-03">
							Ver etapa
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/03.pdf" download>
							PDF
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/03.gpx" download>
							GPX
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/03.mp3">
							Audio
						</a>
					</div>
				</article>

				<article class="rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-5">
					<p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--sp-muted-2)]">
						<span class="h-2.5 w-2.5 rounded-full bg-route-04"></span>
						<span>Etapa 04</span>
					</p>
					<h2 class="mt-2 text-xl font-bold">El Anillo Defensivo</h2>
					<p class="mt-1 text-[var(--sp-muted)]">La Isleta del Moro → San José</p>
					<div class="mt-4 grid gap-2 text-sm text-[var(--sp-muted)]">
						<p><span class="font-semibold text-[var(--sp-text)]">Distancia:</span> 12,3 km</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Duración:</span> 3 horas</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Dificultad:</span> Media-Baja</p>
					</div>
					<div class="mt-5 flex flex-wrap gap-2">
						<a class="inline-flex items-center rounded-md bg-[var(--sp-accent)] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90" href="/etapas/etapa-04">
							Ver etapa
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/04.pdf" download>
							PDF
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/04.gpx" download>
							GPX
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/04.mp3">
							Audio
						</a>
					</div>
				</article>

				<article class="rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-5 sm:col-span-2">
					<p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--sp-muted-2)]">
						<span class="h-2.5 w-2.5 rounded-full bg-route-05"></span>
						<span>Etapa 05</span>
					</p>
					<h2 class="mt-2 text-xl font-bold">El Fin de la Frontera</h2>
					<p class="mt-1 text-[var(--sp-muted)]">San José → La Fabriquilla (Faro)</p>
					<div class="mt-4 grid gap-2 text-sm text-[var(--sp-muted)] sm:grid-cols-3">
						<p><span class="font-semibold text-[var(--sp-text)]">Distancia:</span> 15,12 km</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Duración:</span> 4 horas y media</p>
						<p><span class="font-semibold text-[var(--sp-text)]">Dificultad:</span> Media-Alta</p>
					</div>
					<div class="mt-5 flex flex-wrap gap-2">
						<a class="inline-flex items-center rounded-md bg-[var(--sp-accent)] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90" href="/etapas/etapa-05">
							Ver etapa
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/05.pdf" download>
							PDF
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/05.gpx" download>
							GPX
						</a>
						<a class="inline-flex items-center rounded-md border border-[var(--sp-border-2)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--sp-text)] hover:bg-[var(--sp-surface-2)]" href="/descargas/05.mp3">
							Audio
						</a>
					</div>
				</article>
			</section>
		</div>
	</main>
</Layout>

