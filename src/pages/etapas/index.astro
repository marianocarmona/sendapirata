---
import Layout from '../../layouts/Layout.astro';
import Sp2Shell from '../../components/Sp2Shell.astro';
import Pie from '../../components/Pie.astro';
import Cabecera from '../../components/Cabecera.astro';
import EtapaCard from '../../components/EtapaCard.astro';
import EtapasIntro from '../../components/EtapasIntro.astro';
import JsonLd from '../../components/JsonLd.astro';
import { etapas } from '../../data/etapas';
import { createSocialImageMetadata } from '../../data/site';
import { getSiteBase } from '../../data/seo-urls';
import {
	buildBreadcrumbListSchema,
	buildCollectionPageSchema,
	buildEtapaItemListSchema,
	type SchemaNode,
} from '../../data/structured-data';

const pageTitle = 'Etapas — Senda Pirata';
const pageDescription =
	'Consulta las cinco etapas de la Senda Pirata con el resumen de cada tramo y acceso a sus audios, PDF y GPX.';
const pageSocialImage = createSocialImageMetadata(
	'/images/cartilla.webp',
	'Cartilla de la Senda Pirata con el recorrido de cinco etapas por Cabo de Gata-Níjar.',
);
const pagePath = Astro.url.pathname;
const site = getSiteBase(Astro.site, Astro.url);
const breadcrumbSchema = buildBreadcrumbListSchema(
	[
		{ name: 'Inicio', path: '/' },
		{ name: 'Etapas', path: pagePath },
	],
	{ site },
);
const listingSchemas = [
	buildCollectionPageSchema(
		{
			name: pageTitle,
			description: pageDescription,
			path: pagePath,
		},
		{ site },
	),
	buildEtapaItemListSchema(
		{ site },
		{
			name: pageTitle,
			description: pageDescription,
			path: pagePath,
		},
	),
	breadcrumbSchema,
].filter((schema): schema is SchemaNode => Boolean(schema));
---


<Layout title={pageTitle} description={pageDescription} socialImage={pageSocialImage}>
	<JsonLd slot="head" data={listingSchemas} />
	<Sp2Shell>
		<Cabecera />

		<EtapasIntro />

		<div class="mb-10" aria-label="Etapas">
			{etapas.map((etapa) => (
				<EtapaCard etapa={etapa} variant="list" />
			))}
		</div>

		<Pie />
	</Sp2Shell>
</Layout>
