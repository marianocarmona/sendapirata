---
import '../styles/global.css';
import { SEO } from "astro-seo";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_SOCIAL_IMAGE,
  type SocialImageMetadata,
} from "../data/site";
import { getSiteBase, toAbsoluteUrl, toCanonicalUrl } from "../data/seo-urls";

interface Props {
  title: string;
  description?: string;
  socialImage?: SocialImageMetadata;
}

const { title, description, socialImage } = Astro.props as Props;
const siteUrl = getSiteBase(Astro.site, Astro.url);
const canonicalUrl = toCanonicalUrl(Astro.url.pathname, siteUrl);
const metaDescription = description ?? SITE_DESCRIPTION;
const resolvedSocialImage = socialImage ?? SITE_SOCIAL_IMAGE;
const socialImageUrl = toAbsoluteUrl(resolvedSocialImage.src, siteUrl);
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<GoogleAnalytics measurementId={'G-CEYF0TGFC8'} />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="preload"
			as="image"
			href="/images/grunge-background.webp"
			type="image/webp"
			media="(min-width: 1024px)"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
       <SEO
         title={title}
         description={metaDescription}
         canonical={canonicalUrl}
         openGraph={{
           basic: {
             title,
             type: "website",
             image: socialImageUrl,
             url: canonicalUrl,
           },
           optional: {
             description: metaDescription,
             locale: "es_ES",
             siteName: SITE_NAME,
           },
           image: {
             alt: resolvedSocialImage.alt,
             width: resolvedSocialImage.width,
             height: resolvedSocialImage.height,
           },
         }}
         twitter={{
           card: "summary_large_image",
           title,
           description: metaDescription,
           image: socialImageUrl,
           imageAlt: resolvedSocialImage.alt,
         }}
       />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	@media (min-width: 1024px) {
		body {
			background-image: url('/images/grunge-background.webp');
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			background-attachment: fixed;
		}
	}
</style>
