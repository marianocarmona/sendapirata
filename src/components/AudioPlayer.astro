---
interface Props {
  src: string;
  title?: string;
  subtitle?: string;
  minimal?: boolean;
}

const { src, title = "Audio", subtitle, minimal = false } = Astro.props;

const id = `ap-${Math.random().toString(36).slice(2)}`;
const audioLabel = subtitle ? `${title} — ${subtitle}` : title;
const playLabel = `Reproducir ${audioLabel}`;
const pauseLabel = `Pausar ${audioLabel}`;
const progressLabel = `Progreso de ${audioLabel}`;
const seekLabel = `Barra de progreso de ${audioLabel}`;
const downloadLabel = `Descargar ${audioLabel}`;
---

<div
  class:list={[
    "ap group w-full my-2 text-white",
    minimal
      ? "rounded-2xl border border-white/15 bg-black p-3.5"
      : "rounded-2xl border border-white/15 bg-black p-3.5",
  ]}
  style="--ap-progress: 0%;"
  data-audio-player
  data-ap-variant={minimal ? "minimal" : "default"}
  id={id}
>
  {!minimal ? (
    <div class="flex items-center gap-2.5 mb-2.5">
      <div
        class="grid place-items-center w-9 h-9 rounded-xl border border-white/15 bg-rose-500/15 text-rose-300 shrink-0"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M5 20h14M7 20V9.5c0-1.4 1.1-2.5 2.5-2.5h5c1.4 0 2.5 1.1 2.5 2.5V20"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M10 7V5.5A2.5 2.5 0 0 1 12.5 3H15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </div>
      <div class="min-w-0">
        <p class="m-0 text-[12px] font-extrabold tracking-[0.08em] uppercase text-white/60">{title}</p>
      </div>
    </div>
  ) : null}

  {subtitle ? <p class="m-0 mb-2 text-sm font-semibold text-white">{subtitle}</p> : null}

  <div class="grid grid-cols-[auto_1fr_auto] gap-3 items-center">
    <button
      type="button"
      class="grid place-items-center w-11 h-11 rounded-2xl border border-white/15 bg-white/10 text-white transition-colors hover:bg-white/15"
      aria-label={playLabel}
      data-ap="toggle"
    >
      <span class="inline-flex transition-transform group-hover:scale-110 group-data-[ap-state=playing]:hidden" aria-hidden="true">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none">
          <path d="M9 7v10l9-5-9-5Z" fill="currentColor" />
        </svg>
      </span>
      <span class="hidden transition-transform group-hover:scale-110 group-data-[ap-state=playing]:inline-flex" aria-hidden="true">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none">
          <path d="M7 6h4v12H7V6Zm6 0h4v12h-4V6Z" fill="currentColor" />
        </svg>
      </span>
    </button>

    <div class="min-w-0" role="group" aria-label={progressLabel}>

      <div class="mt-0 flex gap-2 items-center text-[12px] text-white/65 select-none" aria-hidden="false">
        <span data-ap="cur">0:00</span>
        <span class="opacity-70" aria-hidden="true">•</span>
        <span data-ap="dur">0:00</span>
      </div>
      <input
        class="ap-range w-full appearance-none h-2.5 rounded-full border border-white/15 outline-none bg-[linear-gradient(90deg,var(--color-rose-500)_0%,var(--color-rose-500)_var(--ap-progress),rgba(255,255,255,0.15)_var(--ap-progress))]"
        type="range"
        min="0"
        max="1000"
        value="0"
        step="1"
        data-ap="seek"
        aria-label={seekLabel}
      />
    </div>

    <a
      class="grid place-items-center w-11 h-11 rounded-2xl border border-white/15 bg-white/10 text-white transition-colors hover:bg-white/15"
      href={src}
      download
      aria-label={downloadLabel}
      title={downloadLabel}
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 3v10m0 0 4-4m-4 4-4-4M5 17v3h14v-3"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
  </div>

  <audio src={src} preload="none" data-ap="audio"></audio>
</div>

<script is:inline define:vars={{ id, playLabel, pauseLabel }}>
  ;(() => {
    const root = document.getElementById(id)
    if (!root) return
    if (root.dataset.apInitialized === 'true') return
    root.dataset.apInitialized = 'true'

    const audio = root.querySelector('[data-ap="audio"]')
    const btn = root.querySelector('[data-ap="toggle"]')
    const seek = root.querySelector('[data-ap="seek"]')
    const curEl = root.querySelector('[data-ap="cur"]')
    const durEl = root.querySelector('[data-ap="dur"]')

    if (!audio || !btn || !seek || !curEl || !durEl) return

    const fmt = (s) => {
      const sec = Math.max(0, Math.floor(Number(s) || 0))
      const m = Math.floor(sec / 60)
      const r = sec % 60
      return `${m}:${String(r).padStart(2, '0')}`
    }

    const setUi = () => {
      const dur = audio.duration
      const cur = audio.currentTime
      durEl.textContent = Number.isFinite(dur) ? fmt(dur) : '0:00'
      curEl.textContent = Number.isFinite(cur) ? fmt(cur) : '0:00'

      if (Number.isFinite(dur) && dur > 0) {
        const v = Math.round((cur / dur) * 1000)
        seek.value = String(Math.max(0, Math.min(1000, v)))
        root.style.setProperty('--ap-progress', `${v / 10}%`)
      } else {
        seek.value = '0'
        root.style.setProperty('--ap-progress', `0%`)
      }
    }

    const setPlaying = (isPlaying) => {
      root.dataset.apState = isPlaying ? 'playing' : 'paused'
      btn.setAttribute('aria-label', isPlaying ? pauseLabel : playLabel)
    }

    btn.addEventListener('click', async () => {
      try {
        if (audio.paused) {
          await audio.play()
        } else {
          audio.pause()
        }
      } catch (e) {
        console.warn('No se pudo reproducir el audio', e)
      }
    })

    seek.addEventListener('input', () => {
      const dur = audio.duration
      if (!Number.isFinite(dur) || dur <= 0) return
      const v = Number(seek.value) / 1000
      audio.currentTime = dur * v
      setUi()
    })

    audio.addEventListener('loadedmetadata', setUi)
    audio.addEventListener('timeupdate', setUi)
    audio.addEventListener('play', () => setPlaying(true))
    audio.addEventListener('pause', () => setPlaying(false))
    audio.addEventListener('ended', () => {
      setPlaying(false)
      setUi()
    })

    setPlaying(false)
    setUi()
  })()
</script>

<style>
  /* Solo para pseudo-elementos del range (Tailwind no los cubre). */
  .ap-range::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #fff;
    border: 3px solid rgb(244 63 94); /* rose-500 */
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    cursor: pointer;
  }

  .ap-range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #fff;
    border: 3px solid rgb(244 63 94); /* rose-500 */
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    cursor: pointer;
  }
</style>
