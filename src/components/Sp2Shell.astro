---
import sp2CssUrl from "../styles/index2.css?url";

interface Props {
  extraCss?: string[];
}

const { extraCss = [] } = Astro.props as Props;
---

<div class="sp2">
  <link rel="stylesheet" href={sp2CssUrl} />
  {extraCss.map((href) => <link rel="stylesheet" href={href} />)}

  <link rel="stylesheet" href="https://use.typekit.net/pbz8sah.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
    rel="stylesheet"
  />

  <div class="container">
    <div class="card">
      <slot />
    </div>
  </div>
</div>

