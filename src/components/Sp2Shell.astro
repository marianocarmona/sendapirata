---

<div class="min-h-screen flex items-center justify-center p-0 md:p-10 bg-[#f5f0e8] md:bg-transparent font-['Roboto',_sans-serif]">
  <link rel="stylesheet" href="https://use.typekit.net/pbz8sah.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
    rel="stylesheet"
  />

  <div class="w-full max-w-none md:max-w-[1024px] flex justify-center">
    <div class="w-full bg-white shadow-md p-5 md:p-10 rounded-none md:rounded-[20px] min-h-screen md:min-h-0">
      <slot />
    </div>
  </div>
