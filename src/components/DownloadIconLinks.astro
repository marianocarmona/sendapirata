---
import { getImageDimensions } from "../data/image-dimensions";
import type { DownloadAsset } from "../data/etapas";

interface Props {
  links: DownloadAsset[];
  iconClass?: string;
}

const { links, iconClass = "block w-10 h-auto cursor-pointer transition-transform hover:scale-110" } = Astro.props as Props;
---

{links.map((link) => {
  const iconDimensions = getImageDimensions(link.iconSrc);

  return (
    <a href={link.href} download={link.download ? true : undefined} aria-label={link.ariaLabel} title={link.label}>
      <img
        src={link.iconSrc}
        alt={link.iconAlt}
        class={iconClass}
        loading="lazy"
        decoding="async"
        width={iconDimensions.width}
        height={iconDimensions.height}
      />
    </a>
  );
})}
