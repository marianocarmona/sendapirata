---
type RouteDef = { id: string; url: string; color: string };

const MAPBOX_STYLE = "mapbox://styles/nijareno/cmm552aq5005201qz6wey2hho";
const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN ?? "";
const NIJAR_CENTER: [number, number] = [-2.2063888888889, 36.965555555556];

const defaultRoutes: RouteDef[] = [
  { id: "ruta-01", url: "/geojson/01.geojson", color: "#3a5f73" },
  { id: "ruta-02", url: "/geojson/02.geojson", color: "#9a6b2f" },
  { id: "ruta-03", url: "/geojson/03.geojson", color: "#8c3b2e" },
  { id: "ruta-04", url: "/geojson/04.geojson", color: "#4f6b4a" },
  { id: "ruta-05", url: "/geojson/05.geojson", color: "#2f2b26" },
];

interface Props {
  routes?: RouteDef[];
  fitPadding?: number | { top: number; right: number; bottom: number; left: number };
  minHeight?: string;
  interactive?: boolean;
  showExpand?: boolean;
  enableRouteHighlight?: boolean;
  fitMaxHeight?: number;
  fitMaxWidth?: number;
  fitMaxWidthVw?: number;
  fitSymmetricY?: boolean;
}

const {
  routes = defaultRoutes,
  fitPadding = 100,
  minHeight = "100vh",
  interactive = true,
  showExpand = true,
  enableRouteHighlight = false,
  fitMaxHeight,
  fitMaxWidth,
  fitMaxWidthVw,
  fitSymmetricY = true,
} = Astro.props as Props;

const config = JSON.stringify({
  token: MAPBOX_TOKEN,
  style: MAPBOX_STYLE,
  center: NIJAR_CENTER,
  routes,
  fitPadding,
  interactive,
  enableRouteHighlight,
  fitMaxHeight,
  fitMaxWidth,
  fitMaxWidthVw,
  fitSymmetricY,
});
---

<div class="map-shell" data-map-root data-map-config={config}>
  <div class="map-status" data-map-status role="status" aria-live="polite">
    Cargando mapa interactivo...
  </div>

  <div class="map" style={`min-height: ${minHeight};`} data-map-canvas></div>

  {showExpand ? (
    <div class="map-ui" aria-hidden="false">
      <button
        type="button"
        class="map-ui-btn"
        data-map-action="toggle-expand"
        aria-label="Expandir mapa"
        title="Expandir mapa"
      >
        <span data-map-icon="expand" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M9 4H5v4M15 4h4v4M9 20H5v-4M15 20h4v-4"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
        <span data-map-icon="collapse" aria-hidden="true" hidden>
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
      </button>
    </div>
  ) : null}
</div>

<script>
  import "../scripts/map/init";
</script>

<style>
  .map-shell {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .map-status {
    position: absolute;
    inset: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 1px solid var(--sp-border-2);
    border-radius: 16px;
    background: rgba(15, 23, 42, 0.88);
    color: white;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .map-status[hidden] {
    display: none;
  }

  .map-ui {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    pointer-events: none;
  }

  .map-ui-btn {
    pointer-events: auto;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid var(--sp-border-2);
    background: var(--sp-surface);
    color: var(--sp-text);
    box-shadow:
      0 10px 25px rgba(0, 0, 0, 0.35),
      0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .map-ui-btn:hover {
    background: var(--sp-surface-2);
    border-color: var(--sp-accent);
  }

  .map-ui-btn:focus-visible {
    outline: 3px solid rgba(14, 165, 233, 0.9);
    outline-offset: 2px;
  }

  .map-ui-btn svg {
    width: 20px;
    height: 20px;
  }

  .map {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
  }

  :global(html.map-no-scroll) {
    overflow: hidden;
  }

  :global(html.map-no-scroll) audio {
    display: none;
  }

  :global(html.map-no-scroll [data-audio-player]) {
    display: none !important;
  }

  .map-shell.is-expanded {
    position: fixed;
    inset: 0;
    z-index: 9999999999;
    padding: 12px;
    background: rgba(2, 6, 23, 0.45);
    backdrop-filter: blur(4px);
  }

  .map-shell.is-expanded .map {
    border-radius: 16px;
    overflow: hidden;
  }

  .map-shell.is-expanded .map-status {
    inset: 24px;
  }
</style>
