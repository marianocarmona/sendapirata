---
import { getImageDimensions } from "../data/image-dimensions";
import type { EtapaRecord } from "../data/etapas";
import DownloadIconLinks from "./DownloadIconLinks.astro";

interface Props {
  etapa: EtapaRecord;
  variant?: "home" | "list";
}

const { etapa, variant = "list" } = Astro.props as Props;
const links = etapa.cardDownloads[variant];
const cardDimensions = getImageDimensions(etapa.cardImage);
---

<div class="py-[25px] border-b border-black flex flex-row items-start md:items-center gap-[15px] md:gap-[25px] last:border-b-0">
  <a href={etapa.path} aria-label={`Ir a Etapa ${etapa.idLabel}`}>
    <img
      src={etapa.cardImage}
      alt={`Etapa ${etapa.idLabel}`}
      class="shrink-0 object-contain w-[70px] h-[70px] md:w-20 md:h-20"
      loading="lazy"
      decoding="async"
      width={cardDimensions.width}
      height={cardDimensions.height}
    />
  </a>
  <div class="flex flex-col md:flex-row flex-1 gap-2.5 md:gap-[25px] items-start md:items-center">
    <div class="w-full flex-1">
      <h3 class="text-[22px] font-bold text-black leading-[1.3] mb-2.5">
        <a class="text-[inherit] no-underline hover:underline" href={etapa.path}>{etapa.cardTitle}</a>
      </h3>
      <p class="text-base text-[#333]">{etapa.routeSummary}</p>
    </div>
    <div class="flex items-center gap-[18px] shrink-0">
      <DownloadIconLinks links={links} />
    </div>
  </div>
</div>
