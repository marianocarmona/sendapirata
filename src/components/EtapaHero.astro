---
import { getImageDimensions } from "../data/image-dimensions";
import type { EtapaRecord } from "../data/etapas";

interface Props {
  etapa: EtapaRecord;
}

const { etapa } = Astro.props as Props;
const heroDimensions = getImageDimensions(etapa.heroImage);
---

<div class="relative w-full mb-[30px] overflow-hidden rounded-[25px]">
  <img
    class="w-full h-[320px] md:h-[380px] lg:h-[420px] object-cover"
    src={etapa.heroImage}
    alt={etapa.heroAlt}
    width={heroDimensions.width}
    height={heroDimensions.height}
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/25 to-transparent" />
  <div class="absolute inset-0 flex items-end">
    <div class="w-full p-6 md:p-10">
      <p class="text-[12px] font-bold uppercase tracking-[0.12em] bg-black/80 text-white w-fit px-4 py-1 rounded-full mb-3">
        Etapa {etapa.idLabel}
      </p>
      <h1 class="font-bold text-white text-[32px] md:text-[42px] font-['thornwood-vf',_sans-serif]">{etapa.detailTitle}</h1>
      <p class="text-base text-white/90 mt-2">{etapa.heroRouteLabel}</p>
    </div>
  </div>
</div>
