---
interface Props {
	current: number;
	total?: number;
	basePath?: string;
}

const { current, total = 5, basePath = "/etapas/etapa-" } = Astro.props;

const fmt = (n: number) => String(n).padStart(2, "0");

const TITULOS: Record<number, string> = {
	1: "El Guardián del Horizonte",
	2: "La Custodia del Alumbre y la Protección de los Mineros",
	3: "Camino del Botín y la Indefensión del Interior",
	4: "El Anillo Defensivo",
	5: "El Fin de la Frontera",
};

const titulo = (n: number) => TITULOS[n] ?? "";

const prev = current > 1 ? current - 1 : null;
const next = current < total ? current + 1 : null;
---

<nav class="etapa-nav bg-black mt-6! pt-12! border-t border-[var(--sp-border)] md:-mx-[70px] md:px-[70px] relative overflow-visible" aria-label="Navegación entre etapas">
	<div class="flex items-center justify-between gap-4">
		{prev ? (
			<a
				class="group inline-flex min-w-0 flex-1 items-center justify-start gap-4 rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-4! hover:bg-[var(--sp-surface-2)]"
				href={`${basePath}${fmt(prev)}`}
				aria-label={`Volver a etapa ${fmt(prev)}`}
			>
				<span class="shrink-0 text-sm font-semibold text-white">← Anterior</span>
				<span class="min-w-0">
					<span class="block truncate text-sm font-semibold text-white">Etapa {fmt(prev)}</span>
					<span class="mt-1 block truncate text-base font-semibold text-white">{titulo(prev)}</span>
				</span>
			</a>
		) : (
			<span class="min-w-0 flex-1 rounded-xl border border-transparent p-4 text-sm text-white">
				&nbsp;
			</span>
		)}

		{next ? (
			<a
				class="group inline-flex min-w-0 flex-1 items-center justify-end gap-4 rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-4! text-right hover:bg-[var(--sp-surface-2)]"
				href={`${basePath}${fmt(next)}`}
				aria-label={`Avanzar a etapa ${fmt(next)}`}
			>
				<span class="min-w-0">
					<span class="block truncate text-sm font-semibold text-white">Etapa {fmt(next)}</span>
					<span class="mt-1 block truncate text-base font-semibold text-white">{titulo(next)}</span>
				</span>
				<span class="shrink-0 text-sm font-semibold text-white">Siguiente →</span>
			</a>
		) : (
			<span class="min-w-0 flex-1 rounded-xl border border-transparent p-4 text-sm text-white text-right">
				&nbsp;
			</span>
		)}
	</div>
</nav>

<style>
	@media (min-width: 768px) {
		.etapa-nav::before,
		.etapa-nav::after {
			content: "";
			position: absolute;
			bottom: -15px;
			width: 30px;
			height: 15px;
			background: rgba(0, 0, 0, 0.5);
			z-index: 2;
			pointer-events: none;
		}

		/* Pliegue inferior izquierdo */
		.etapa-nav::before {
			left: 0;
			clip-path: polygon(0 0, 100% 0, 100% 100%);
		}

		/* Pliegue inferior derecho */
		.etapa-nav::after {
			right: 0;
			clip-path: polygon(0 0, 100% 0, 0 100%);
		}
	}
</style>
