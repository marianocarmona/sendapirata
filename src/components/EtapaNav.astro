---
interface Props {
	current: number;
	total?: number;
	basePath?: string;
}

const { current, total = 5, basePath = "/etapas/etapa-" } = Astro.props;

const fmt = (n: number) => String(n).padStart(2, "0");

const TITULOS: Record<number, string> = {
	1: "El Guardián del Horizonte",
	2: "La Custodia del Alumbre y la Protección de los Mineros",
	3: "Camino del Botín y la Indefensión del Interior",
	4: "El Anillo Defensivo",
	5: "El Fin de la Frontera",
};

const titulo = (n: number) => TITULOS[n] ?? "";

const prev = current > 1 ? current - 1 : null;
const next = current < total ? current + 1 : null;
---

<nav class="mt-12 border-t border-[var(--sp-border)] pt-6" aria-label="Navegación entre etapas">
	<div class="flex items-center justify-between gap-4">
		{prev ? (
			<a
				class="group inline-flex min-w-0 flex-1 items-center justify-start gap-4 rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-4 hover:bg-[var(--sp-surface-2)]"
				href={`${basePath}${fmt(prev)}`}
				aria-label={`Volver a etapa ${fmt(prev)}`}
			>
				<span class="shrink-0 text-sm font-semibold text-[var(--sp-muted)]">← Anterior</span>
				<span class="min-w-0">
					<span class="block truncate text-sm font-semibold text-[var(--sp-text)]">Etapa {fmt(prev)}</span>
					<span class="mt-1 block truncate text-base font-semibold text-[var(--sp-text)]">{titulo(prev)}</span>
				</span>
			</a>
		) : (
			<span class="min-w-0 flex-1 rounded-xl border border-transparent p-4 text-sm text-[var(--sp-muted-2)]">
				&nbsp;
			</span>
		)}

		{next ? (
			<a
				class="group inline-flex min-w-0 flex-1 items-center justify-end gap-4 rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-4 text-right hover:bg-[var(--sp-surface-2)]"
				href={`${basePath}${fmt(next)}`}
				aria-label={`Avanzar a etapa ${fmt(next)}`}
			>
				<span class="min-w-0">
					<span class="block truncate text-sm font-semibold text-[var(--sp-text)]">Etapa {fmt(next)}</span>
					<span class="mt-1 block truncate text-base font-semibold text-[var(--sp-text)]">{titulo(next)}</span>
				</span>
				<span class="shrink-0 text-sm font-semibold text-[var(--sp-muted)]">Siguiente →</span>
			</a>
		) : (
			<span class="min-w-0 flex-1 rounded-xl border border-transparent p-4 text-sm text-[var(--sp-muted-2)] text-right">
				&nbsp;
			</span>
		)}
	</div>
</nav>

