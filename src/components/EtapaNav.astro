---
import { etapas, totalEtapas } from "../data/etapas";

interface Props {
	current: number;
	total?: number;
	basePath?: string;
}

const { current, total = totalEtapas, basePath = "/etapas/etapa-" } = Astro.props;

const fmt = (n: number) => String(n).padStart(2, "0");
const TITULOS = new Map(etapas.map((etapa) => [etapa.id, etapa.cardTitle]));

const titulo = (n: number) => TITULOS.get(n) ?? "";
const navLabel = (prefix: string, n: number) => {
	const stageTitle = titulo(n);

	return `${prefix} la etapa ${fmt(n)}${stageTitle ? ` — ${stageTitle}` : ""}`;
};

const prev = current > 1 ? current - 1 : null;
const next = current < total ? current + 1 : null;
---


<nav
	class="etapa-nav relative mt-6! overflow-visible border-t border-[var(--sp-border)] bg-black py-6! md:-mx-[70px] md:px-[70px] md:py-8!"
	aria-label="Navegación entre etapas"
>
	<div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between md:gap-4">
		{prev ? (
			<a
				class="group inline-flex min-w-0 w-full items-center justify-between gap-3 rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-3! hover:bg-[var(--sp-surface-2)] md:flex-1 md:justify-start md:gap-4 md:p-4!"
				href={`${basePath}${fmt(prev)}`}
				aria-label={navLabel("Volver a", prev)}
			>
				<span class="shrink-0 text-sm font-semibold text-white">← Anterior</span>
				<span class="min-w-0">
					<span class="block truncate text-xs font-semibold uppercase tracking-[0.08em] text-white md:text-sm md:normal-case md:tracking-normal">
						Etapa {fmt(prev)}
					</span>
					<span class="mt-1 block truncate text-sm font-semibold text-white md:text-base">{titulo(prev)}</span>
				</span>
			</a>
		) : (
			<span class="hidden min-w-0 flex-1 rounded-xl border border-transparent p-4 text-sm text-white md:block" aria-hidden="true">
				&nbsp;
			</span>
		)}

		{prev && next && <div aria-hidden="true" class="my-1 h-[4px] w-full bg-white/20 md:hidden"></div>}

		{next ? (
			<a
				class="group inline-flex min-w-0 w-full items-center justify-between gap-3 rounded-xl border border-[var(--sp-border)] bg-[var(--sp-surface)] p-3! text-left hover:bg-[var(--sp-surface-2)] md:flex-1 md:justify-end md:gap-4 md:p-4! md:text-right"
				href={`${basePath}${fmt(next)}`}
				aria-label={navLabel("Avanzar a", next)}
			>
				<span class="min-w-0">
					<span class="block truncate text-xs font-semibold uppercase tracking-[0.08em] text-white md:text-sm md:normal-case md:tracking-normal">
						Etapa {fmt(next)}
					</span>
					<span class="mt-1 block truncate text-sm font-semibold text-white md:text-base">{titulo(next)}</span>
				</span>
				<span class="shrink-0 text-sm font-semibold text-white">Siguiente →</span>
			</a>
		) : (
			<span class="hidden min-w-0 flex-1 rounded-xl border border-transparent p-4 text-right text-sm text-white md:block" aria-hidden="true">
				&nbsp;
			</span>
		)}
	</div>
</nav>

<style>
	@media (min-width: 768px) {
		.etapa-nav::before,
		.etapa-nav::after {
			content: "";
			position: absolute;
			bottom: -15px;
			width: 30px;
			height: 15px;
			background: rgba(0, 0, 0, 0.5);
			z-index: 2;
			pointer-events: none;
		}

		/* Pliegue inferior izquierdo */
		.etapa-nav::before {
			left: 0;
			clip-path: polygon(0 0, 100% 0, 100% 100%);
		}

		/* Pliegue inferior derecho */
		.etapa-nav::after {
			right: 0;
			clip-path: polygon(0 0, 100% 0, 0 100%);
		}
	}
</style>
